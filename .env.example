# ============================================================================
# FORTIXX — VARIÁVEIS DE AMBIENTE
# ============================================================================
# Copie este arquivo para .env.local e preencha com as chaves reais de cada
# plataforma. Nenhuma chave real deve ser commitada no Git — .env.local já
# está no .gitignore.
#
# Depois de preencher, rode:
#   npm run setup          → valida as chaves e aplica as migrations no Supabase
#   npm run stripe:setup   → cria os produtos/preços no Stripe automaticamente
#   node scripts/vercel-env-sync.js  → envia estas variáveis para a Vercel
# ============================================================================

# ---- SUPABASE ---------------------------------------------------------------
# Painel do projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Painel do projeto → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# ---- APP ----------------------------------------------------------------
# URL pública da aplicação (usada em e-mails, redirects de auth, checkout)
# Local: http://localhost:3000 · Produção: https://app.suaempresa.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- STRIPE ---------------------------------------------------------------
# Painel Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Painel Stripe → Developers → Webhooks → seu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Preenchidos automaticamente por `npm run stripe:setup`, ou cole os Price IDs
# manualmente se já tiver os produtos criados (Painel → Product catalog)
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ---- RESEND (e-mail transacional) -----------------------------------------
# Painel Resend → API Keys
RESEND_API_KEY=re_...
# Precisa ser um domínio verificado no Resend (Painel → Domains)
RESEND_FROM_EMAIL="Fortixx <noreply@seudominio.com>"

# ---- N8N (automação: parsing de currículo, notificações) -------------------
# URL do webhook do workflow "resume-parse" (n8n/workflows/resume-parse.json)
N8N_WEBHOOK_URL_RESUME_PARSE=https://SEU-N8N.app.n8n.cloud/webhook/resume-parse
# Segredo compartilhado — o mesmo valor deve ser configurado como header
# X-Webhook-Secret no node HTTP Request do workflow n8n, e também na
# credencial usada pelo workflow para chamar de volta /api/webhooks/n8n
N8N_WEBHOOK_SECRET=
